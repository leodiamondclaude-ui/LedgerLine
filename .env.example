# Public address of the app; used in invite and reset links. Use https in production (turns on secure cookies).
APP_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=data/ledgerline.db
# Set to 1 when running behind a proxy or load balancer, so sign-in limits use the real visitor address
TRUST_PROXY=0

# Receipt reading (Claude). Without a key, the scan card is hidden and entries are typed by hand.
ANTHROPIC_API_KEY=

# Email for invites and password resets (Resend). Without a key, links are printed in the server log.
RESEND_API_KEY=
MAIL_FROM=Ledgerline <no-reply@yourdomain.com>

# Billing (Stripe). Without these, every firm can use the app with no trial limit.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14
# Shown on the front page after the trial line, e.g. "$49 a month per firm"
PRICE_LABEL=
